	file = {arXiv Fulltext PDF:/Users/andrew/Zotero/storage/8BD5WUVR/He et al. - 2015 - Deep Residual Learning for Image Recognition.pdf:application/pdf;arXiv.org Snapshot:/Users/andrew/Zotero/storage/LZFXNZHK/1512.html:text/html},
