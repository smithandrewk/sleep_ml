	pmcid = {PMC4993274},
	keywords = {Animals, Electrodes, Implanted, Electroencephalography, Epidural Space, Epilepsy, Imaging, Three-Dimensional, Mice, Rats, Stereotaxic Techniques},
	pages = {54216},
	file = {Full Text:/Users/andrew/Zotero/storage/EII6I69I/Papazoglou et al. - 2016 - Non-restraining EEG Radiotelemetry Epidural and Deep Intracerebral Stereotaxic EEG Electrode Placem.pdf:application/pdf},
