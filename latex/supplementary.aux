\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces  \textbf  {Stacked representation of algorithm predictions, raw data, and algorithm confidence for one fold. }\hskip 1em\relax (A) The reference hypnogram as annotated by a human expert. (B) The predicted hypnogram as predicted by the algorithm. (C) The raw EEG signal that is used as the sole network input. (D) The probability distribution over sleep stages produced by the network. Additionally, the confidence level of the network is denoted by black line. P - paradoxical sleep, S - slow-wave sleep, W - wakefulness. }}{6}{figure.6}\protected@file@percent }
\newlabel{hypnogram}{{S6}{6}{\textbf {Stacked representation of algorithm predictions, raw data, and algorithm confidence for one fold. }\quad (A) The reference hypnogram as annotated by a human expert. (B) The predicted hypnogram as predicted by the algorithm. (C) The raw EEG signal that is used as the sole network input. (D) The probability distribution over sleep stages produced by the network. Additionally, the confidence level of the network is denoted by black line. P - paradoxical sleep, S - slow-wave sleep, W - wakefulness}{figure.6}{}}
