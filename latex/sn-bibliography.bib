	keywords = {⍺7 nicotinic acetylcholine receptor, Animals, Brain, Electroencephalography, Electromyography, Female, Kynurenic Acid, Kynurenine, Male, neuropharmacology, non‐rapid eye movement sleep, Polysomnography, rapid eye movement sleep, Rats, Rats, Wistar, sleep spindles, Sleep Wake Disorders, Transaminases, tryptophan, Wakefulness},
