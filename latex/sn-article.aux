\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Results of SleepyRat dataset statistical analysis comparing LSTM scoring and human expert scoring.}\hskip 1em\relax P values are indicated for main effects of scoring, ZT, and interaction between scoring and ZT. * indicates significant effect wherein P $<$ 0.05. P values of two-way RM ANOVA.}}{13}{table.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  \textbf  {Sleep-wake duration and architecture data do not significantly differ between LSTM and human expert scoring of SleepyRat dataset. }\hskip 1em\relax (A) NREM duration, (B) REM duration, (C) Wake duration, (D) NREM bout number, (E) REM bout number, (F) Wake bout number, (G) average NREM bout duration, (H) average REM bout duration, (I) average Wake bout duration. Two-way RM ANOVA with post-hoc Dunnett test. * P < 0.05, ** P < 0.01, *** P < 0.001, **** P < 0.0001. Data are mean $\pm $ SEM. N =14 per group. }}{14}{figure.3}\protected@file@percent }
\newlabel{architecture}{{3}{14}{\textbf {Sleep-wake duration and architecture data do not significantly differ between LSTM and human expert scoring of SleepyRat dataset. }\quad (A) NREM duration, (B) REM duration, (C) Wake duration, (D) NREM bout number, (E) REM bout number, (F) Wake bout number, (G) average NREM bout duration, (H) average REM bout duration, (I) average Wake bout duration. Two-way RM ANOVA with post-hoc Dunnett test. * P < 0.05, ** P < 0.01, *** P < 0.001, **** P < 0.0001. Data are mean $\pm $ SEM. N =14 per group}{figure.3}{}}
